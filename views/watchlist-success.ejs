<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= pageTitle %></title>
  <!-- TailwindCSS -->
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 min-h-screen flex flex-col items-center justify-center p-6">

  <h1 class="text-3xl font-bold text-green-600 mb-6 text-center">
    ✅ "<%= addedMovie.title %>" added to your Watchlist!
  </h1>

  <h2 class="text-2xl font-semibold mb-4">Your Current Watchlist:</h2>

  <% if (movies.length === 0) { %>
    <p class="text-gray-500">Your watchlist is empty.</p>
  <% } else { %>
    <ul class="space-y-2 mb-8">
      <% movies.forEach(movie => { %>
        <li class="bg-white p-4 rounded shadow w-full max-w-md">
          <strong><%= movie.title %></strong> (<%= movie.year %>) - <%= movie.genre %>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <div class="flex space-x-4 mt-6">
    <a href="/">
      <button class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-6 rounded">
        🏠 Back to Home
      </button>
    </a>
    <a href="/watchlist">
      <button class="bg-purple-500 hover:bg-purple-600 text-white font-bold py-2 px-6 rounded">
        🎬 View Full Watchlist
      </button>
    </a>
  </div>

</body>
</html>
