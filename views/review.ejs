<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Submit Review</title>
  <style>
    body { font-family: sans-serif; padding: 20px; }
    label, select, input, textarea, button { display: block; margin: 10px 0; }
    button { background-color: #4CAF50; color: white; border: none; padding: 8px 16px; cursor: pointer; }
    button:hover { background-color: #45a049; }
  </style>
</head>
<body>
  <h1>Submit a Review</h1>

  <form action="/reviews" method="POST">
    <!-- MOVIE DROPDOWN -->
    <label for="movieId">Choose Movie:</label>
    <select id="movieId" name="movieId" required>
      <% movies.forEach(movie => { %>
        <option value="<%= movie._id %>">
          <%= movie.title %> (<%= movie.year %>)
        </option>
      <% }) %>
    </select>

    <!-- RATING -->
    <label for="rating">Rating (1–5):</label>
    <input
      type="number"
      id="rating"
      name="rating"
      min="1"
      max="5"
      required
    />

    <!-- COMMENT -->
    <label for="comment">Comment:</label>
    <textarea id="comment" name="comment"></textarea>

    <!-- SUBMIT -->
    <button type="submit">Submit Review</button>
  </form>
</body>
</html>
