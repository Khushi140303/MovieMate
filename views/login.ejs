<!DOCTYPE html>
<html lang="en">
<head>
  <title>Login</title>
  <!-- TailwindCSS -->
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 flex flex-col items-center justify-center min-h-screen">

  <h1 class="text-4xl font-bold mb-8">Login</h1>

  <% if (errorMsg) { %>
    <p id="errorMsg" class="text-red-500 mb-4 text-center"><%= errorMsg %></p>
  <% } %>

  <form action="/auth/login" method="POST" class="bg-white p-8 rounded shadow-md flex flex-col space-y-4 w-full max-w-sm">
    <input name="username" placeholder="Username" required
      class="border border-gray-300 rounded p-3 focus:outline-none focus:ring-2 focus:ring-green-400" />
    <input name="password" type="password" placeholder="Password" required
      class="border border-gray-300 rounded p-3 focus:outline-none focus:ring-2 focus:ring-green-400" />
    <button type="submit"
      class="bg-green-500 hover:bg-green-600 text-white font-bold py-2 rounded">
      Login
    </button>
  </form>

  <a href="/" class="mt-6">
    <button class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded">
      🏠 Back to Home
    </button>
  </a>

</body>
</html>
