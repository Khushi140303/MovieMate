<!DOCTYPE html>
<html>
<head>
  <title>MovieMate</title>
  <style>
    body {
      font-family: sans-serif;
      padding: 20px;
    }

    h1 {
      font-size: 40px;
      margin-bottom: 30px;
    }

    input[type="text"], input[type="number"], button {
      font-size: 18px;
      padding: 10px;
      margin: 5px;
      width: 200px;
    }

    button {
      width: auto;
      background-color: #4CAF50;
      color: white;
      border: none;
      cursor: pointer;
    }

    button:hover {
      background-color: #45a049;
    }

    .movie {
      margin-top: 20px;
    }

    #errorMsg {
      color: red;
      margin-top: 10px;
    }

    .auth-links {
      margin-bottom: 20px;
    }
  </style>
</head>
<body>
  <!-- ✅ LOGIN/LOGOUT SECTION -->
  <div class="auth-links">
    <% if (user) { %>
      <p>Welcome, <%= user.username %>!</p>
      <form action="/auth/logout" method="POST">
        <button type="submit">Logout</button>
      </form>
    <% } else { %>
      <a href="/auth/login">Login</a> |
      <a href="/auth/register">Register</a>
    <% } %>
  </div>

  <h1>Add a Movie</h1>

  <form id="movieForm" action="/add" method="POST">
    <input id="title" type="text" name="title" placeholder="Movie title" required />
    <input id="genre" type="text" name="genre" placeholder="Genre" required />
    <input id="year" type="number" name="year" placeholder="Year" required />
    <button type="submit">Add Movie</button>
    <p id="errorMsg"></p>
  </form>

  <hr>

  <h2>Your Movies</h2>

  <% if (movies.length === 0) { %>
    <p>No movies added yet.</p>
  <% } else { %>
    <ul>
      <% movies.forEach(movie => { %>
        <li class="movie">
          <strong><%= movie.title %></strong> (<%= movie.year %>) - <%= movie.genre %>
          <form method="POST" action="/delete-movie" style="display:inline;">
            <input type="hidden" name="movieId" value="<%= movie._id %>">
            <button type="submit">🗑️ Delete</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <!-- ✅ CONDITIONAL REVIEW LINK -->
  <% if (user) { %>
    <hr />
    <a href="/reviews">
      <button>Submit a Review</button>
    </a>
  <% } %>

  <!-- ✅ Client-side validation -->
  <script>
    const form = document.getElementById('movieForm');
    const errorMsg = document.getElementById('errorMsg');

    form.addEventListener('submit', function (e) {
      const title = document.getElementById('title').value.trim();
      const genre = document.getElementById('genre').value.trim();
      const year = document.getElementById('year').value.trim();

      if (!title || !genre || !year) {
        e.preventDefault();
        errorMsg.textContent = "All fields are required!";
      } else if (isNaN(year) || year < 1888 || year > new Date().getFullYear()) {
        e.preventDefault();
        errorMsg.textContent = "Please enter a valid year.";
      } else {
        errorMsg.textContent = "";
      }
    });
  </script>
</body>
</html>
