<!DOCTYPE html>
<html>
<head>
  <title>MovieMate</title>
  <!-- TailwindCSS -->
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <style>
    body {
      font-family: sans-serif;
      padding: 20px;
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col items-center">

  <!-- ✅ LOGIN/LOGOUT SECTION -->
  <div class="flex space-x-4 mb-8">
    <% if (user) { %>
      <p class="text-lg font-semibold">Welcome, <%= user.username %>!</p>
      <form action="/auth/logout" method="POST">
        <button class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded">
          Logout
        </button>
      </form>
    <% } else { %>
      <a href="/auth/login" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded">Login</a>
      <a href="/auth/register" class="bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded">Register</a>
    <% } %>
  </div>

  <h1 class="text-4xl font-bold mb-6">Add a Movie</h1>

  <form id="movieForm" action="/add" method="POST" class="flex flex-col space-y-4 max-w-md w-full bg-white p-6 rounded shadow">

    <% if (errorMsg) { %>
      <p id="errorMsg" class="text-red-500 text-center"><%= errorMsg %></p>
    <% } %>

    <div class="relative">
      <input id="title" type="text" name="title" placeholder="Movie title"
        class="border border-gray-300 p-2 rounded w-full" required autocomplete="off" />
      <div id="autocomplete-results" class="absolute bg-white border border-gray-300 rounded w-full mt-1 z-10 max-h-60 overflow-y-auto"></div>
    </div>

    <input id="genre" type="text" name="genre" placeholder="Genre" class="border border-gray-300 p-2 rounded w-full" required />
    <input id="year" type="number" name="year" placeholder="Year" class="border border-gray-300 p-2 rounded w-full" required />

    <button type="submit" class="bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded">
      ➕ Add Movie
    </button>

  </form>

  <hr class="w-full my-8">

  <h2 class="text-2xl font-semibold mb-4"><%= pageTitle %></h2>

  <% if (movies.length === 0) { %>
    <p class="text-gray-500">No movies added yet.</p>
  <% } else { %>
    <ul class="space-y-4 w-full max-w-2xl">
      <% movies.forEach(movie => { %>
        <li class="bg-white p-4 rounded shadow flex flex-col sm:flex-row justify-between items-center">
          <div>
            <strong><%= movie.title %></strong> (<%= movie.year %>) - <%= movie.genre %>
          </div>

          <div class="flex space-x-2 mt-4 sm:mt-0">
            <% if (user) { %>
              <form method="POST" action="/watchlist/add/<%= movie._id %>">
                <button type="submit" class="bg-blue-400 hover:bg-blue-500 text-white py-1 px-3 rounded">
                  ➕ Watchlist
                </button>
              </form>
            <% } %>

            <form method="POST" action="/delete-movie">
              <input type="hidden" name="movieId" value="<%= movie._id %>">
              <button type="submit" class="bg-red-400 hover:bg-red-500 text-white py-1 px-3 rounded">
                🗑️ Delete
              </button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <% if (user) { %>
    <hr class="w-full my-8" />
    <a href="/reviews">
      <button class="bg-purple-500 hover:bg-purple-600 text-white font-bold py-2 px-6 rounded">
        ✍️ Submit a Review
      </button>
    </a>
  <% } %>

  <!-- ✅ Client-side validation -->
  <script>
    const form = document.getElementById('movieForm');
    const errorMsg = document.getElementById('errorMsg');

    form.addEventListener('submit', function (e) {
      const title = document.getElementById('title').value.trim();
      const genre = document.getElementById('genre').value.trim();
      const year = document.getElementById('year').value.trim();

      if (!title || !genre || !year) {
        e.preventDefault();
        errorMsg.textContent = "All fields are required!";
      } else if (isNaN(year) || year < 1888 || year > new Date().getFullYear()) {
        e.preventDefault();
        errorMsg.textContent = "Please enter a valid year.";
      } else {
        errorMsg.textContent = "";
      }
    });
  </script>

  <!-- ✅ Autocomplete + Autofill with OMDb -->
<script>
  const titleInput = document.getElementById('title');
  const genreInput = document.getElementById('genre');
  const yearInput = document.getElementById('year');
  const resultsBox = document.getElementById('autocomplete-results');

  let debounceTimer;

  titleInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(fetchSuggestions, 300);
  });

  async function fetchSuggestions() {
    const query = titleInput.value.trim();
    if (!query) {
      resultsBox.innerHTML = "";
      return;
    }

    const res = await fetch(`/search-titles?q=${encodeURIComponent(query)}`);
    const results = await res.json();

    resultsBox.innerHTML = "";
    results.forEach(movie => {
      const item = document.createElement('div');
      item.textContent = `${movie.title} (${movie.year})`;
      item.className = "p-2 hover:bg-gray-200 cursor-pointer";

      item.addEventListener('mousedown', async () => {
        titleInput.value = movie.title;
        resultsBox.innerHTML = "";

        // ✨ Autofill genre and year!
        try {
          const detailsRes = await fetch(`/fetch-movie-details?title=${encodeURIComponent(movie.title)}`);
          const data = await detailsRes.json();

          if (data.success) {
            genreInput.value = data.genre;
            yearInput.value = data.year;
          }
        } catch (err) {
          console.error('Failed to fetch movie details:', err);
        }
      });

      resultsBox.appendChild(item);
    });
  }

  titleInput.addEventListener('blur', () => {
    setTimeout(() => resultsBox.innerHTML = "", 200);
  });
</script>


</body>
</html>
